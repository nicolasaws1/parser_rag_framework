# Copie para .env e preencha. O .env NUNCA vai para o repositório.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
# chave de servidor: ignora RLS. Não deixe chegar ao navegador nem ao repo.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ── API de curadoria (de onde vêm metadados e PDFs) ─────────────────────────
CURATION_API_URL=https://exemplo.com
CURATION_API_USER=usuario
CURATION_API_PASSWORD=senha

# ── Deploy ──────────────────────────────────────────────────────────────────
# Fecha /api/fila e /api/worker/heartbeat: só passa quem mandar o cabeçalho
# X-Worker-Token com este valor. Vazio = endpoints abertos.
# Gere com: openssl rand -hex 32
WORKER_TOKEN=

# Hostname que o Caddy vai servir. Ele só responde para o que estiver aqui.
# Aceita vários, separados por vírgula, para atender IP e domínio ao mesmo tempo:
#   DOMINIO=10.147.20.5, 172.26.0.10, sb100.exemplo.br
DOMINIO=localhost

# UM nome só (não aceita lista): é o que o Caddy usa quando o cliente não manda
# SNI, o que acontece sempre que se acessa por IP. Ponha o endereço principal.
SNI_PADRAO=localhost

# Caddyfile.interno = certificado do próprio Caddy, sobe sem depender de ninguém.
# Caddyfile.origem  = Origin Certificate do Cloudflare, quando ele entregar
#                     (deploy/certs/origin.pem e origin.key).
CADDYFILE=Caddyfile.interno

# ── Opcional ────────────────────────────────────────────────────────────────
# onde os PDFs originais ficam na máquina (scripts/acervo.py)
# PDF_DIR=C:\caminho\para\PDFS aprovados

# Token do túnel Cloudflare (só com --profile tunel). Quem administra a zona gera.
TUNNEL_TOKEN=

# Porta em que a API fica exposta na rede do servidor (o cloudflared aponta
# para ela em HTTP; o TLS termina no Cloudflare).
API_PORTA=8000
