# Copie para .env e preencha. O .env NUNCA vai para o repositório.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
# chave de servidor: ignora RLS. Não deixe chegar ao navegador nem ao repo.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ── API de curadoria (de onde vêm metadados e PDFs) ─────────────────────────
CURATION_API_URL=https://exemplo.com
CURATION_API_USER=usuario
CURATION_API_PASSWORD=senha

# ── Deploy ──────────────────────────────────────────────────────────────────
# Fecha /api/fila e /api/worker/heartbeat: só passa quem mandar o cabeçalho
# X-Worker-Token com este valor. Vazio = endpoints abertos.
# Gere com: openssl rand -hex 32
WORKER_TOKEN=

# hostname que o Caddy vai servir (o mesmo que o Cloudflare vai apontar)
DOMINIO=sb100.exemplo.com.br

# ── Opcional ────────────────────────────────────────────────────────────────
# onde os PDFs originais ficam na máquina (scripts/acervo.py)
# PDF_DIR=C:\caminho\para\PDFS aprovados
